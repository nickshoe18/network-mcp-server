# ──────────────────────────────────────────────────
#  NetOps UI — Root Environment
#  Copy to .env and fill in your values.
# ──────────────────────────────────────────────────

# Anthropic API key — platform.anthropic.com > API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Path to your hpe-networking-mcp secrets folder
SECRETS_DIR=/Users/nickshoemaker/hpe-networking-mcp/secrets

# Optional FRIDAY settings (defaults are applied by the backend)
# FRIDAY_MODEL=claude-sonnet-5
# FRIDAY_AUTOPILOT_ENABLED=true
# FRIDAY_POLL_INTERVAL_MS=120000
# FRIDAY_DATA_DIR=/app/data
# FRIDAY_SLE_EPISODE_GAP_MS=5400000
# FRIDAY_SLE_RENOTIFY_COOLDOWN_MS=14400000
# FRIDAY_RESOLUTION_CONFIRM_POLLS=2
# FRIDAY_ENTITY_ALERT_COOLDOWN_MS=1800000
# FRIDAY_REMEDIATION_ENABLED=false
